# ========================================================
# Kredensial Cloudflare R2 untuk File Storage Publik
# ========================================================

# 1. Cloudflare Account ID (Bisa didapat di dashboard kanan Cloudflare)
R2_ACCOUNT_ID=your_cloudflare_account_id

# 2. R2 API Token (Buat di R2 -> Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# 3. Nama Bucket R2 yang dibuat
R2_BUCKET_NAME=absen-public

# 4. Public Access Domain R2 (R2.dev subdomain atau Custom Domain terhubung)
# Contoh: https://pub-xxxxxx.r2.dev atau https://berkas.sekolahkamu.com
R2_PUBLIC_URL=https://pub-your_r2_subdomain.r2.dev
